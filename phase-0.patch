diff --git a/scripts/neon-snapshot.mjs b/scripts/neon-snapshot.mjs
new file mode 100644
index 0000000..45dd734
--- /dev/null
+++ b/scripts/neon-snapshot.mjs
@@ -0,0 +1,94 @@
+#!/usr/bin/env node
+/**
+ * Create a Neon branch of the production database before migrations run.
+ *
+ * A Neon branch is a copy-on-write snapshot of the parent at the moment it is
+ * created, so a migration that goes wrong can be inspected or recovered from.
+ * The branch is given an expiry so snapshots clean themselves up.
+ *
+ * Environment
+ *   NEON_API_KEY                 secret; API key with access to the project
+ *   NEON_PROJECT_ID              project id (not secret)
+ *   NEON_PRODUCTION_BRANCH_ID    id of the production branch to snapshot
+ *   NEON_SNAPSHOT_REQUIRED       "true" makes any failure or missing setting fail the job
+ *   NEON_SNAPSHOT_TTL_DAYS       days until the snapshot expires (default 14)
+ *   NEON_API_BASE                override for tests (default https://console.neon.tech/api/v2)
+ *   GITHUB_SHA, GITHUB_RUN_ID, GITHUB_RUN_ATTEMPT   used to name the branch
+ *
+ * While the settings are absent the step only warns, so it can ship before the
+ * secrets exist. Set NEON_SNAPSHOT_REQUIRED=true to make it a hard gate.
+ */
+import { appendFileSync } from "node:fs";
+
+const env = process.env;
+const base = (env.NEON_API_BASE || "https://console.neon.tech/api/v2").replace(/\/+$/, "");
+const required = env.NEON_SNAPSHOT_REQUIRED === "true";
+const ttlDays = Number(env.NEON_SNAPSHOT_TTL_DAYS || 14);
+
+function finish(level, message, code) {
+  if (level === "error") console.error(`::error::${message}`);
+  else if (level === "warning") console.log(`::warning::${message}`);
+  else console.log(message);
+  process.exit(code);
+}
+
+function fail(message) {
+  if (required) finish("error", message, 1);
+  finish("warning", `${message} Continuing without a snapshot because NEON_SNAPSHOT_REQUIRED is not "true".`, 0);
+}
+
+const missing = ["NEON_API_KEY", "NEON_PROJECT_ID", "NEON_PRODUCTION_BRANCH_ID"].filter((k) => !env[k]);
+if (missing.length) {
+  fail(`Pre-migration snapshot not configured: ${missing.join(", ")} not set.`);
+}
+if (!Number.isFinite(ttlDays) || ttlDays <= 0) {
+  fail("NEON_SNAPSHOT_TTL_DAYS must be a positive number.");
+}
+
+const sha = (env.GITHUB_SHA || "local").slice(0, 7);
+const run = `${env.GITHUB_RUN_ID || Date.now()}-${env.GITHUB_RUN_ATTEMPT || 1}`;
+const name = `pre-migrate-${sha}-${run}`;
+const expiresAt = new Date(Date.now() + ttlDays * 86_400_000).toISOString();
+
+async function createBranch(withExpiry) {
+  const branch = { name, parent_id: env.NEON_PRODUCTION_BRANCH_ID };
+  if (withExpiry) branch.expires_at = expiresAt;
+  const res = await fetch(`${base}/projects/${encodeURIComponent(env.NEON_PROJECT_ID)}/branches`, {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${env.NEON_API_KEY}`,
+      "Content-Type": "application/json",
+      Accept: "application/json",
+    },
+    body: JSON.stringify({ branch }),
+    signal: AbortSignal.timeout(30_000),
+  });
+  const text = await res.text();
+  let json = null;
+  try { json = JSON.parse(text); } catch { /* non-JSON error body */ }
+  return { res, json, text };
+}
+
+let result;
+try {
+  result = await createBranch(true);
+  // If this API version rejects expires_at, still take the snapshot.
+  if ([400, 422].includes(result.res.status)) {
+    console.log("::warning::Neon rejected the branch expiry; creating the snapshot without auto-delete.");
+    result = await createBranch(false);
+  }
+} catch (error) {
+  fail(`Neon snapshot request failed: ${error instanceof Error ? error.message : String(error)}.`);
+}
+
+if (!result.res.ok || !result.json?.branch?.id) {
+  const detail = (result.json?.message || result.text || "").slice(0, 200);
+  fail(`Neon snapshot failed with HTTP ${result.res.status}${detail ? `: ${detail}` : ""}.`);
+}
+
+const branchId = result.json.branch.id;
+const line = `Pre-migration snapshot created: ${name} (${branchId}).`;
+if (env.GITHUB_STEP_SUMMARY) {
+  appendFileSync(env.GITHUB_STEP_SUMMARY, `### Pre-migration snapshot\n\n- Neon branch: \`${name}\` (\`${branchId}\`)\n- Expires: ${expiresAt}\n`);
+}
+finish("info", line, 0);
diff --git a/scripts/neon-snapshot.test.mjs b/scripts/neon-snapshot.test.mjs
new file mode 100644
index 0000000..87f8580
--- /dev/null
+++ b/scripts/neon-snapshot.test.mjs
@@ -0,0 +1,103 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import { execFile } from "node:child_process";
+import { fileURLToPath } from "node:url";
+import { dirname, join } from "node:path";
+
+const script = join(dirname(fileURLToPath(import.meta.url)), "neon-snapshot.mjs");
+
+function startMock(handler) {
+  const requests = [];
+  const server = createServer((req, res) => {
+    let body = "";
+    req.on("data", (c) => (body += c));
+    req.on("end", () => {
+      const parsed = body ? JSON.parse(body) : null;
+      requests.push({ method: req.method, url: req.url, auth: req.headers.authorization, body: parsed });
+      handler(requests.length, parsed, res);
+    });
+  });
+  return new Promise((resolve) =>
+    server.listen(0, "127.0.0.1", () => resolve({ server, requests, base: `http://127.0.0.1:${server.address().port}` })),
+  );
+}
+
+function run(env) {
+  return new Promise((resolve) => {
+    execFile(process.execPath, [script], { env: { PATH: process.env.PATH, ...env }, timeout: 20_000 }, (error, stdout, stderr) =>
+      resolve({ code: error ? error.code : 0, stdout, stderr }),
+    );
+  });
+}
+
+const good = (n, body, res) => {
+  res.setHeader("Content-Type", "application/json");
+  res.end(JSON.stringify({ branch: { id: "br-snap-1", name: body.branch.name } }));
+};
+const cfg = (base, extra = {}) => ({
+  NEON_API_KEY: "key-123",
+  NEON_PROJECT_ID: "proj-1",
+  NEON_PRODUCTION_BRANCH_ID: "br-prod",
+  NEON_API_BASE: base,
+  GITHUB_SHA: "abcdef1234567890",
+  GITHUB_RUN_ID: "42",
+  GITHUB_RUN_ATTEMPT: "1",
+  ...extra,
+});
+
+test("creates an expiring branch from the production branch", async () => {
+  const m = await startMock(good);
+  const r = await run(cfg(m.base));
+  m.server.close();
+  assert.equal(r.code, 0);
+  assert.match(r.stdout, /Pre-migration snapshot created: pre-migrate-abcdef1-42-1 \(br-snap-1\)/);
+  assert.equal(m.requests.length, 1);
+  assert.equal(m.requests[0].url, "/projects/proj-1/branches");
+  assert.equal(m.requests[0].auth, "Bearer key-123");
+  assert.equal(m.requests[0].body.branch.parent_id, "br-prod");
+  assert.ok(m.requests[0].body.branch.expires_at);
+});
+
+test("retries without expiry when the API rejects expires_at", async () => {
+  const m = await startMock((n, body, res) => {
+    if (n === 1) { res.statusCode = 400; res.end(JSON.stringify({ message: "unknown field expires_at" })); return; }
+    good(n, body, res);
+  });
+  const r = await run(cfg(m.base));
+  m.server.close();
+  assert.equal(r.code, 0);
+  assert.equal(m.requests.length, 2);
+  assert.equal(m.requests[1].body.branch.expires_at, undefined);
+  assert.match(r.stdout, /without auto-delete/);
+});
+
+test("warns and continues when settings are missing and the step is not required", async () => {
+  const r = await run({});
+  assert.equal(r.code, 0);
+  assert.match(r.stdout, /::warning::.*NEON_API_KEY, NEON_PROJECT_ID, NEON_PRODUCTION_BRANCH_ID/);
+});
+
+test("fails when settings are missing and the step is required", async () => {
+  const r = await run({ NEON_SNAPSHOT_REQUIRED: "true" });
+  assert.notEqual(r.code, 0);
+  assert.match(r.stderr, /::error::/);
+});
+
+test("warns on API failure when not required, fails when required", async () => {
+  const m = await startMock((n, body, res) => { res.statusCode = 500; res.end("boom"); });
+  const soft = await run(cfg(m.base));
+  const hard = await run(cfg(m.base, { NEON_SNAPSHOT_REQUIRED: "true" }));
+  m.server.close();
+  assert.equal(soft.code, 0);
+  assert.match(soft.stdout, /HTTP 500/);
+  assert.notEqual(hard.code, 0);
+});
+
+test("never prints the API key", async () => {
+  const m = await startMock((n, body, res) => { res.statusCode = 401; res.end(JSON.stringify({ message: "bad key-123" })); });
+  const r = await run(cfg(m.base, { NEON_SNAPSHOT_REQUIRED: "true" }));
+  m.server.close();
+  assert.ok(!r.stdout.includes("Bearer"));
+  assert.ok(!r.stderr.includes("Bearer"));
+});
