generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum VerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum OwnerPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
}

enum Role {
  STUDENT
  OWNER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  MIXED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

enum HostelStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  BOOKING_REFUNDED
  MESSAGE_RECEIVED
  REVIEW_RECEIVED
  HOSTEL_APPROVED
  HOSTEL_REJECTED
  PRICE_ALERT
}

// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String?
  name          String
  phone         String?
  phoneVerified DateTime?
  avatar        String?
  role          Role      @default(STUDENT)
  bio           String?   @db.Text
  city          String?
  tokenVersion            Int                 @default(0)
  emailNotifications      Boolean             @default(true)
  studentVerified         Boolean             @default(false)
  verificationStatus      VerificationStatus  @default(NONE)
  verificationDocUrl      String?
  verificationSubmittedAt DateTime?
  verificationDecidedAt   DateTime?
  verifiedById            String?             // Admin userId who approved/rejected this verification.
  plan                    OwnerPlan           @default(FREE)
  subscription            Subscription?
  bankAccountTitle        String?
  bankAccountNumber       String?
  bankName                String?

  accounts      Account[]
  sessions      Session[]
  hostels       Hostel[]
  bookings      Booking[]
  payouts       Payout[]
  reviews       Review[]
  favorites     Favorite[]
  messages      Message[]
  conversationParticipants ConversationParticipant[]
  passwordResets PasswordResetToken[]
  priceAlerts    PriceAlert[]
  notifications  Notification[]
  deviceTokens   DeviceToken[]
  phoneVerificationTokens PhoneVerificationToken[]
  roommmatePosts    RoommatePost[]
  roommateReports  RoommateReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String   // "ios" | "android"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Subscription {
  id            String             @id @default(cuid())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String             @unique
  plan          OwnerPlan
  status        SubscriptionStatus @default(PENDING)
  paymentRef    String?
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("subscriptions")
}

model Payout {
  id        String       @id @default(cuid())
  owner     User         @relation(fields: [ownerId], references: [id])
  ownerId   String
  amount    Int          // Whole-integer PKR, sum of included bookings' totals.
  status    PayoutStatus @default(PENDING)
  reference String?      // Bank/JazzCash transfer reference, filled in when marked paid.
  bookings  Booking[]
  createdAt DateTime     @default(now())
  createdBy String       // Admin userId who generated the batch.
  paidAt    DateTime?
  paidBy    String?      // Admin userId who marked it paid.

  @@index([ownerId])
  @@index([status])
  @@map("payouts")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PhoneVerificationToken {
  phone      String   // Phone number being verified
  otp        String   // 6-digit OTP
  userId     String?  // Optional: if verifying for existing user
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts   Int      @default(0) // Track failed attempts
  expires    DateTime

  @@unique([phone, otp])
  @@index([phone])
  @@index([userId])
  @@map("phone_verification_tokens")
}

model Hostel {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String       @db.Text
  status      HostelStatus @default(DRAFT)

  // Location
  city      String
  area      String?
  address   String
  latitude  Float?
  longitude Float?

  // Details
  pricePerMonth Int
  rooms         Int
  capacity      Int
  gender        Gender  @default(MIXED)
  minStay       Int     @default(1) // months
  maxStay       Int?

  // Features (stored as JSON arrays of strings)
  amenities String[]
  rules     String[]

  // Media
  images    String[]
  coverImage String?

  // Flags
  verified Boolean @default(false)
  featured Boolean @default(false)

  // Stats (denormalized for read performance)
  viewCount   Int   @default(0)
  rating      Float @default(0)
  reviewCount Int   @default(0)

  // Relations
  owner     User      @relation(fields: [ownerId], references: [id])
  ownerId   String
  rooms_rel Room[]
  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]
  conversations Conversation[]
  priceAlerts PriceAlert[]
  notifications Notification[]
  blockedDates BlockedDate[]
  roommmatePosts  RoommatePost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([slug])
  @@index([ownerId])
  @@index([status, featured])
  @@index([gender])
  @@index([pricePerMonth])
  @@map("hostels")
}

model Room {
  id       String @id @default(cuid())
  hostelId String
  hostel   Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  pricePerMonth Int
  capacity      Int
  available     Int     // tracks remaining spots — used for optimistic locking
  version       Int     @default(0) // optimistic lock version

  images String[]

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostelId])
  @@map("rooms")
}

model Booking {
  id String @id @default(cuid())

  hostel   Hostel @relation(fields: [hostelId], references: [id])
  hostelId String
  room     Room?  @relation(fields: [roomId], references: [id])
  roomId   String?
  user     User   @relation(fields: [userId], references: [id])
  userId   String

  checkIn  DateTime
  checkOut DateTime
  months   Int
  guests   Int      @default(1)
  total    Int      // Whole-integer PKR. Never use Float for currency — see formatPrice (packages/shared/src/utils).

  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  transactionId String?       @unique
  refundedAt    DateTime?
  refundedBy    String?       // Admin userId who processed the refund.

  status BookingStatus @default(PENDING)
  notes  String?       @db.Text

  payout   Payout? @relation(fields: [payoutId], references: [id])
  payoutId String?

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostelId])
  @@index([userId])
  @@index([status])
  @@index([checkIn, checkOut])
  @@index([payoutId])
  @@map("bookings")
}

model Review {
  id String @id @default(cuid())

  hostel   Hostel @relation(fields: [hostelId], references: [id])
  hostelId String
  user     User   @relation(fields: [userId], references: [id])
  userId   String

  rating  Int    // 1–5
  title   String?
  comment String @db.Text

  cleanliness Int @default(0)
  location    Int @default(0)
  value       Int @default(0)
  safety      Int @default(0)

  wouldRecommend Boolean?

  ownerReply  String?  @db.Text
  repliedAt   DateTime?
  verified    Boolean  @default(false)

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hostelId, userId])
  @@index([hostelId])
  @@index([userId])
  @@map("reviews")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model Favorite {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  hostel   Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  hostelId String

  createdAt DateTime @default(now())

  @@unique([userId, hostelId])
  @@index([userId])
  @@map("favorites")
}

model Conversation {
  id String @id @default(cuid())

  hostel     Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  hostelId   String
  hostelName String // Snapshot of hostel name at conversation time — intentionally stale

  participants ConversationParticipant[]
  messages     Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostelId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  joinedAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  content String  @db.Text
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model PriceAlert {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  hostel   Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  hostelId String
  
  // Alert triggers when price drops below this threshold
  targetPrice Int
  
  // Last known price (for accurate price comparison in alerts)
  lastKnownPrice Int?
  
  // Whether the alert is still active
  active Boolean @default(true)
  
  // When the user last received an alert for this hostel
  lastAlertAt DateTime?

  unsubscribeToken String   @default(cuid()) @unique
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, hostelId])
  @@index([userId])
  @@index([hostelId])
  @@index([active])
  @@map("price_alerts")
}

model Notification {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  type    NotificationType
  title   String
  message String @db.Text
  
  // Related booking (for booking notifications)
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  bookingId String?

  // Related review (for review notifications)
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  reviewId String?

  // Related hostel (for hostel notifications)
  hostel   Hostel? @relation(fields: [hostelId], references: [id], onDelete: SetNull)
  hostelId String?

  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([bookingId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

// Tracks last run time and status of each cron job.
// Used by /api/health/crons to detect missed/failing jobs.
model CronLog {
  id         String   @id @default(cuid())
  name       String   @unique
  ranAt      DateTime
  status     String   // "success" | "error"
  durationMs Int
  error      String?
  updatedAt  DateTime @updatedAt

  @@map("cron_logs")
}

model BlockedDate {
  id        String   @id @default(cuid())
  hostel    Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  hostelId  String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([hostelId])
  @@map("blocked_dates")
}

model RoommatePost {
  id        String    @id @default(cuid())
  hostel    Hostel    @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  hostelId  String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  bio       String    @db.Text
  budget    Int?      // PKR/month, optional
  moveIn    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  reports   RoommateReport[]

  @@unique([hostelId, userId])
  @@index([hostelId, expiresAt])
  @@map("roommate_posts")
}

model RoommateReport {
  id         String       @id @default(cuid())
  post       RoommatePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  reason     String
  createdAt  DateTime     @default(now())

  @@unique([postId, reporterId])
  @@map("roommate_reports")
}
