{
  "name": "hostello",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x",
    "npm": ">=12.2.2"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --webpack",
    "postbuild": "node scripts/patch-routes-manifest.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seat-holds:preflight": "tsx scripts/preflight-seat-holds.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:preview": "node scripts/migrate-preview.mjs",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "schedule-cron": "tsx scripts/schedule-cron-jobs.ts",
    "e2e": "playwright test",
    "migrate:new": "prisma migrate dev",
    "prepare": "simple-git-hooks",
    "typesense:setup": "tsx scripts/setup-typesense.ts",
    "typesense:verify-fallback": "tsx scripts/verify-typesense-fallback.ts",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check-docs.mjs",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1115.0",
    "@hostello/shared": "file:packages/shared",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@sentry/nextjs": "^10.70.0",
    "@upstash/qstash": "^2.11.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.33.0",
    "next": "^16.4.0",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.2.8",
    "resend": "^6.21.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.6.0",
    "typesense": "^3.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "if git diff --cached --name-only | grep -q 'prisma/schema.prisma'; then if ! git diff --cached --name-only | grep -q '^prisma/migrations/'; then printf '\\nERROR: Schema changed without a migration. Run: npm run migrate:new\\n\\n' >&2; exit 1; fi; fi"
  },
  "overrides": {
    "prisma": {
      "mysql2": "3.24.4"
    },
    "gaxios": {
      "uuid": "11.1.1"
    },
    "braces": "^3.0.3"
  }
}
